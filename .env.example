# ── Website contact form → info@travelbug.pk ────────────────────────────────
# Uses the SiteGround mailbox the domain already has, so there is no second
# mail provider and no DNS change: the existing SPF and DKIM records already
# authorise this sender, which is what keeps the messages out of spam.
#
# Set these in Vercel → Settings → Environment Variables (all environments).
# Until they exist the form tells the visitor it could not send and offers
# WhatsApp, rather than claiming success.
SMTP_HOST=mail.travelbug.pk
SMTP_PORT=465
SMTP_USER=info@travelbug.pk
SMTP_PASS=
# Where enquiries land. Defaults to SMTP_USER. Comma-separated for several.
MAIL_TO=info@travelbug.pk

# ── Analytics / verification (already in use) ───────────────────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
